# Copy this file to .env and fill in real values. Never commit .env to git.
# For installed apps, run Deploy-Env.ps1 — it copies .env to:
#   %LOCALAPPDATA%\RxBarcodeListener\.Environment
# Keys are read at runtime; they are NOT embedded in the published exe.

NimbleRxBearerToken=
NimbleRxBaseUrl=https://api-prod.nimblerx.com
NimbleRxTaskUrlTemplate=https://admin.nimblerx.com/admin/pharmacyDashboard/{taskId}

PioneRxBaseUrl=https://172.18.129.10
PioneRxApiKey=
PioneRxSharedSecret=
PioneRxEmployeeId=
CaliforniaMedicaidPayMethod=California Medicaid

MarginFeeUpc=490000002324
MarginFeeThreshold=3.00
PioneRxScreens=Point of Sale,Create Bag

BarcodePattern=(?i)[XC](\d{7})\d{2}
BagBarcodePattern=(?i)B[0-9A-Z]{8}

WillCallBaseUrl=https://172.18.129.10:42856
WillCallLocationId=85aad4a6-2277-413f-a8d8-078493614999
WillCallAuthLocationId=ccf12dfe-9312-4d7a-bca0-10987d49eaba
WillCallApplicationId=02239bfd-deae-44de-89bc-581f26d7d6ac
# From Inventory app session — portal-personID + portal-securityToken / SecurityToken.EncryptedToken
WillCallPersonId=
WillCallEncryptedToken=
# Optional — defaults match Inventory mobile app if omitted
# WillCallMobileDeviceId=05bfbca2-256d-47ed-8ff6-4883a7949a42
# WillCallApplicationVersion=6.1.3

BufferTimeoutMs=500
SentryDsn=
ToastDurationMs=12000

# Leave blank to use %LOCALAPPDATA%\RxBarcodeListener\log.txt
LogFilePath=

NetworkSharePath=\\YOUR-SERVER\RxBarcodeListener
GitHubRepoOwner=lukejamison
GitHubRepoName=RxBarcodeListener
